<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <APackageRPackageReleaseNotes></PackageReleaseNotes>REalLEASE_NOTES>M>>MD.DMD
    <PackageProjectUrl>https://mlunhinged.visualstudio.com/FLearn</PackageProjectUrl>
    <Authors>Brendan van Rooyen</Authors>
    <Description>A Supervised Learning Library for F#</Description>
    <Version>2.0.3.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="RELEASE_NOTES.md" />
    <None Include="LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <Compile Include="src\Domain Types.fs" />
    <Compile Include="src\Utilities.fs" />
    <Compile Include="src\Distributions.fs" />
    <Compile Include="src\LinkFunctions.fs" />
    <Compile Include="src\LossFunctions.fs" />
    <Compile Include="src\LearningWithCorruption.fs" />
    <Compile Include="src\PerformanceMeasures.fs" />
    <Compile Include="src\CoversAndSubSamples.fs" />
    <Compile Include="src\FeatureMaps.fs" />
    <Compile Include="src\Learners.fs" />
    <Compile Include="src\Projections.fs" />
    <Compile Include="src\Sparse Learning.fs" />
    <None Include="examples\Getting Started with FLearn.fsx" />
    <None Include="examples\Online Learning.fsx" />
    <None Include="examples\Projections and the Lasso.fsx" />
    <None Include="examples\Sparse Learning.fsx" />
    <None Include="examples\Learning with Corruption.fsx" />
    <None Include="examples\Multiclass Classification on MNIST.fsx" />
    <None Include="examples\Variance Estimation.fsx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics.FSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="7.0.400" />
  </ItemGroup>

</Project>
