<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisLevel>preview-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <Version>2.0.3.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" />
    <None Include="LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <Compile Include="Domain Types.fs" />
    <Compile Include="Utilities.fs" />
    <Compile Include="Distributions.fs" />
    <Compile Include="LinkFunctions.fs" />
    <Compile Include="LossFunctions.fs" />
    <Compile Include="LearningWithCorruption.fs" />
    <Compile Include="PerformanceMeasures.fs" />
    <Compile Include="CoversAndSubSamples.fs" />
    <Compile Include="FeatureMaps.fs" />
    <Compile Include="Learners.fs" />
    <Compile Include="Projections.fs" />
    <Compile Include="Sparse Learning.fs" />
    <None Include="examples\Getting Started with FLearn.fsx" />
    <None Include="examples\Online Learning.fsx" />
    <None Include="examples\Projections and the Lasso.fsx" />
    <None Include="examples\Learning with Corruption.fsx" />
    <None Include="examples\Multiclass Classification on MNIST.fsx" />
    <None Include="examples\Variance Estimation.fsx" />
    <None Include="examples\Estimating Dependence.fsx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics.FSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="7.0.400" />
  </ItemGroup>

</Project>
